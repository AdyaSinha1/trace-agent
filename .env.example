# Copy to .env and fill in. .env is git-ignored — never commit or print secrets.
GROQ_API_KEY=<your-groq-api-key>
# No default is guessed: online LLM calls HARD-FAIL with a "set GROQ_MODEL" message if unset.
# Put a verified model id here (see https://console.groq.com/docs/models).
GROQ_MODEL=<set-a-verified-model-id>
